# LOCAL DEVELOPMENT (SQLite)
DATABASE_URL="file:dev.db"

# PRODUCTION DATABASE (Supabase PostgreSQL Connection Pooling)
# DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# AUTHENTICATION (NextAuth v5)
AUTH_SECRET="edutech_secret_key_development_32_bytes_min_length"
NEXTAUTH_SECRET="edutech_secret_key_development_32_bytes_min_length"
NEXTAUTH_URL="http://localhost:3000"

# AI TUTOR PROVIDERS
# The system will automatically use whichever key is provided.
# You only need to provide ONE of the following keys:

# 1. Google Gemini (Default)
GEMINI_API_KEY="AIzaSy..."

# 2. Groq (Fastest, uses Llama 3)
GROQ_API_KEY="gsk_..."

# 3. OpenRouter (Uses Llama 3.1)
OPENROUTER_API_KEY="sk-or-v1-..."
